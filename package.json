{
	"name": "hoalu",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --filter=\"./apps/*\"",
		"dev:apps": "node scripts/dev.ts",
		"docker:up": "cd deployments && docker compose -f docker-compose.local.yml up -d --build",
		"docker:down": "cd deployments && docker compose -f docker-compose.local.yml down",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"knip": "knip",
		"repos:sync": "bash scripts/sync-repos.sh"
	},
	"devDependencies": {
		"@types/node": "^25.9.9",
		"knip": "^6.48.0",
		"oxfmt": "^0.53.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2008",
		"tsx": "^4.23.15",
		"turbo": "^2.11.13",
		"typescript": "^7.0.2",
		"vite": "^8.3.8"
	},
	"packageManager": "pnpm@12.18.0"
}
